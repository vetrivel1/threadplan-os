# threadsPlan AI — environment template
# Copy to .env.local and fill in. Every value is optional: with none of them
# the app runs fully in demo mode using in-memory seed data.

# --- AI Co-Pilot (optional) ---
# Without this the co-pilot falls back to deterministic rule-based options.
OPENAI_API_KEY=

# --- Supabase (optional) ---
# Provide BOTH url and a key to enable persistence, auth and realtime.
# Leave blank to stay in demo mode.
NEXT_PUBLIC_SUPABASE_URL=

# Supply exactly one of the following. Newer Supabase projects issue a
# "publishable key"; older ones call the same value the "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
